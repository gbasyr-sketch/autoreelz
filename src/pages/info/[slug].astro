---
import StoreLayout from '../../layouts/StoreLayout.astro';
import Icon from '../../components/Icon.astro';
const pages:Record<string,{title:string;paragraphs:string[]}>= {
 delivery:{title:'Доставка и оплата',paragraphs:['Отправление из Махачкалы по всей России. Планируются СДЭК до пункта выдачи и курьером. Самовывоза нет.','Стоимость доставки рассчитывается для конкретного заказа с учётом упаковки. Если расчёт недоступен, менеджер уточнит стоимость до оплаты.','Товары в наличии и предзаказ оформляются отдельно, с отдельной доставкой. Предзаказ не оплачивается сразу: сначала менеджер подтверждает срок и условия.','Сейчас открыта демонстрационная витрина. Реальные расчёты, платежи картой и СБП пока не подключены.']},
 contacts:{title:'Контакты',paragraphs:['Реквизиты продавца, телефон, email и ссылки на каналы связи ещё не предоставлены. Они появятся здесь после подтверждения владельцем.','AUTO REELZ — детали автомобильного интерьера. География доставки — Россия, город отправления — Махачкала.']},
 account:{title:'Личный кабинет',paragraphs:['В рабочем магазине здесь будут заказы, предзаказы и их статусы. Вход — по одноразовому коду на email, без постоянного пароля.','В демонстрационной витрине вход ещё не подключён. Email и другие персональные данные сейчас не запрашиваются.']},
};
const page=pages[Astro.params.slug??''];if(!page)Astro.response.status=404;
---
<StoreLayout title={page?.title??'Страница не найдена'}><main id="main" class="container page-pad"><nav class="breadcrumbs"><a href="/">Главная</a><span>{page?.title??'404'}</span></nav><div class="page-intro"><p class="eyebrow">Демонстрационная версия</p><h1>{page?.title??'Страница не найдена'}</h1>{page?.paragraphs.map(p=><p>{p}</p>)}</div><a class="button-secondary" href="/catalog">Перейти в каталог <Icon name="arrow"/></a></main></StoreLayout>
