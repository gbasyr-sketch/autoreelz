---
import ManagerLayout from '../../layouts/ManagerLayout.astro';
import ManagerAccess from '../../components/ManagerAccess.astro';
---
<ManagerLayout title="Заказы" active="orders"><section data-workspace="orders"><header class="dash-header"><div><p class="dash-eyebrow">Работа с покупателями</p><h1>Заказы</h1></div><button class="dash-button" data-workspace-refresh type="button">Обновить</button></header><ManagerAccess/>
<div data-workspace-content hidden><p class="mgr-test-note">Тестовые заказы · реальные оплаты ещё не подключены</p><form class="mgr-filter-panel" data-order-filters><label class="dash-field mgr-search">Поиск<input name="q" type="search" maxlength="100" placeholder="Номер, покупатель, телефон или email"/></label><label class="dash-field">Тип<select name="kind"><option value="all">Все</option><option value="ordinary">Из наличия</option><option value="preorder">Предзаказы</option></select></label><label class="dash-field">Оплата<select name="payment"><option value="all">Все статусы</option><option value="unpaid">Не оплачен</option><option value="pending">Ожидается</option><option value="paid">Оплачен · тест</option><option value="failed">Ошибка оплаты</option><option value="review">На проверке</option></select></label><label class="dash-field">Доставка<select name="delivery"><option value="all">Все статусы</option><option value="pending_quote">Нужно уточнить</option><option value="quoted">Рассчитана</option><option value="packing">Сборка</option><option value="shipped">Отправлен</option><option value="delivered">Получен</option></select></label><label class="dash-field">Задача<select name="task"><option value="all">Все задачи</option><option value="packing">Ждут сборки</option><option value="quote">Уточнить доставку</option><option value="confirm">Подтвердить предзаказ</option><option value="review">Проверить оплату</option></select></label><label class="dash-field">Создан с · МСК<input type="date" name="from"/></label><label class="dash-field">По дату · МСК<input type="date" name="to"/></label><div class="mgr-filter-actions"><button type="reset" class="dash-button">Сбросить</button><button class="dash-button dash-primary" type="submit">Найти</button></div></form>
<section class="dash-panel"><div class="dash-section-head"><h2>Список заказов</h2><span data-orders-total></span></div><table class="dash-table mgr-record-table" data-orders-table><thead><tr><th>Заказ</th><th>Покупатель</th><th>Оплата</th><th>Доставка</th><th class="dash-number">Сумма</th></tr></thead><tbody data-order-list></tbody></table><p class="dash-empty" data-list-empty hidden>Заказы по этим условиям не найдены.</p><nav class="mgr-pagination" aria-label="Страницы заказов" data-order-pagination></nav></section></div></section><script>import '../../scripts/manager-orders';</script></ManagerLayout>
