# Copy/generate locally with: python3 scripts/init-env.py
# Secrets are generated in .env; never commit that file.
COMPOSE_PROJECT_NAME=autoreelz2026-new
POSTGRES_DB=autoreelz2026_new
POSTGRES_USER=ar_migrator
POSTGRES_PASSWORD=
CMS_DB_PASSWORD=
APP_DB_PASSWORD=
READ_DB_PASSWORD=
DIRECTUS_SECRET=
ADMIN_EMAIL=admin@autoreelz.example.com
ADMIN_PASSWORD=
EDITOR_EMAIL=editor@autoreelz.example.com
EDITOR_PASSWORD=
CMS_PORT=28055
DB_PORT=65432
WEB_PORT=14323

# Stage 4: local-only commerce adapters
APP_SECRET=
STORE_MODE=local-test
APP_ORIGIN=http://127.0.0.1:14323

# SEO stays disabled in local-test; production activation requires HTTPS and separate approval.
SEO_INDEXING_ENABLED=false
YML_COMPANY_NAME=

# Explicitly opt into the TEST shop only after its credentials have been verified.
PAYMENT_PROVIDER=simulation
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# CDEK directory and calculator only; no shipments.
SHIPPING_PROVIDER=simulation
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_FROM_PVZ=
CDEK_FROM_CITY_CODE=

# Browser map key must be restricted by HTTP Referer in Yandex.
PICKUP_MAP_PROVIDER=osm
YANDEX_MAPS_API_KEY=
