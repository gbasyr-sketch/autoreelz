---
import StoreLayout from '../../layouts/StoreLayout.astro';
import {catalogAlias} from '../../server/seo';
import Icon from '../../components/Icon.astro';
import Reviews from '../../components/Reviews.astro';
import {getReviews} from '../../server/social';
import {getCatalog} from '../../server/catalog';
import {money,productHref} from '../../lib/format';
import {multiplyRubles} from '../../lib/money';
const catalog=await getCatalog();
const {products,categories,vehicles,offerFor,findSku,attributeLabel,attributeDefinitions}=catalog;
const currentYear=new Date().getFullYear();
import '../../styles/product.css';
const product=products.find(p=>p.slug===Astro.params.slug);
if(!product){const slug=await catalogAlias('product',Astro.params.slug??'',catalog);if(slug)return Astro.redirect('/product/'+encodeURIComponent(slug)+Astro.url.search,301);}
const sku=Astro.url.searchParams.get('sku');
const offer=product?offerFor(product,sku):null;
if(!product||!offer)Astro.response.status=404;
const variant=offer?.variant;
const category=categories.find(c=>c.slug===product?.category);
const vehicle=vehicles.find(v=>v.slug===Astro.url.searchParams.get('vehicle'));
const version=vehicle?.versions.find(v=>v.id===Astro.url.searchParams.get('version'));
const year=Astro.url.searchParams.get('year')??'';
const ac=Astro.url.searchParams.get('ac')??'';
let fitmentError='';
if(Astro.url.searchParams.has('vehicle')&&!vehicle)fitmentError='Выберите автомобиль из списка.';
else if(vehicle&&(!/^\d{4}$/.test(year)||Number(year)<1970||Number(year)>currentYear))fitmentError=`Укажите год выпуска от 1970 до ${currentYear}.`;
else if(vehicle&&year&&((vehicle.yearFrom!==null&&Number(year)<vehicle.yearFrom)||(vehicle.yearTo!==null&&Number(year)>vehicle.yearTo)))fitmentError='Год выпуска не входит в диапазон выбранного автомобиля.';
else if(Astro.url.searchParams.get('version')&&!version)fitmentError='Выберите модификацию этого автомобиля.';
else if(vehicle&&!['yes','no','unknown'].includes(ac))fitmentError='Укажите наличие кондиционера.';
if(fitmentError&&offer)Astro.response.status=400;
const color=variant?.attributes.illumination;
const componentRows=product?.components?.flatMap(c=>{const found=findSku(c.skuId);return found?[{...c,...found}]:[]});
const media=variant?.media??product?.media??[];
const image=variant?.image??product?.image;
const placeholder=Boolean(product?.isDemo)||!media.length;
const fitment=product&&offer&&vehicle&&!fitmentError?catalog.fitmentFor(product,offer,{vehicleId:vehicle.id,versionId:version?.id,year:Number(year),ac}):'unknown';
const fitmentLabel=fitment==='compatible'?'Совместимость подтверждена':fitment==='incompatible'?'Не подходит выбранному автомобилю':'Совместимость уточняется';
const reviews=product&&offer&&Astro.locals.shopSession?await getReviews(Astro.locals.shopSession,product.id):null;
---
<StoreLayout catalog={catalog} description={product?.metaDescription} title={product&&offer?(product.seoTitle??product.name):'Товар не найден'} active="product">
<main id="main" class="container product-page">
{product&&offer?<>
  <nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><a href="/catalog">Каталог</a>{category?.ancestorSlugs.map(slug=><a href={`/catalog?category=${slug}`}>{categories.find(c=>c.slug===slug)?.name}</a>)}<a href={`/catalog?category=${product.category}`}>{category?.name}</a></nav>
  <div class="product-layout" data-current-sku={variant?.id??''}>
    <section class="product-intro"><div class="product-overline"><span>{category?.name}{product.isDemo?' · демо-товар':''}</span><button class="icon-button js-only" data-favorite={product.id} aria-pressed="false" aria-label={`В избранное: ${product.name}`}><Icon name="heart"/></button></div><h1>{product.name}</h1><p>{product.kind==='bundle'?'Готовый состав из конкретных исполнений.':'Выберите исполнение для вашего интерьера.'}</p></section>
    <section class="product-media" aria-label="Галерея товара">
      <div class:list={['gallery-stage',placeholder&&color&&`light-${color}`]}><span class="gallery-index">{media.length?`01 / ${String(media.length).padStart(2,'0')}`:'01 / 01'}</span><img id="product-image" src={image} width="720" height="480" alt={media[0]?.alt||`${placeholder?'Изображение-заглушка: ':''}${product.name}`} fetchpriority="high"/>{placeholder&&<span class="gallery-caption"><Icon name="info" size={15}/>Изображение-заглушка</span>}<button class="gallery-zoom icon-button js-only" data-zoom aria-label="Увеличить изображение"><Icon name="search"/></button></div>
      {media.length>1&&<div class="gallery-thumbs" aria-label="Фотографии товара">{media.map((m,i)=><a href={m.src} target="_blank" rel="noopener" aria-label={`Открыть фотографию ${i+1}`}><img src={m.src} width="720" height="480" loading="lazy" alt={m.alt||`${product.name} — фото ${i+1}`}/></a>)}</div>}
      {product.isDemo&&<p class="product-demo">Демонстрационный товар. Цена, наличие и характеристики — примеры для проверки магазина, не предложение о продаже.</p>}
    </section>
    <section class="product-purchase" aria-label="Исполнение и покупка">
      <details class="fitment-box" open={Boolean(vehicle)||Boolean(fitmentError)} id="compatibility"><summary><Icon name="car"/><span><strong>Подойдёт вашему автомобилю?</strong><small>{vehicle?`${vehicle.name} · ${fitmentLabel.toLowerCase()}`:'Укажите модель и комплектацию'}</small></span><span class="fitment-action">Проверить</span></summary><form action={`/product/${product.slug}#compatibility`} class="product-fitment-form">
        {variant&&<input type="hidden" name="sku" value={variant.id}/>}
        <label class="field">Автомобиль<select name="vehicle" required><option value="">Выберите модель</option>{vehicles.map(v=><option value={v.slug} selected={v.id===vehicle?.id}>{v.name}</option>)}</select></label>
        {(vehicle?.versions.length??0)>0&&<label class="field">Модификация<select name="version"><option value="">Не выбрана</option>{vehicle?.versions.map(v=><option value={v.id} selected={v.id===version?.id}>{v.name}</option>)}</select></label>}
        <label class="field">Год<input type="number" inputmode="numeric" name="year" value={year} min="1970" max={currentYear} required placeholder="2015"/></label>
        <label class="field">Кондиционер<select name="ac" required><option value="">Выберите</option><option value="yes" selected={ac==='yes'}>Есть</option><option value="no" selected={ac==='no'}>Нет</option><option value="unknown" selected={ac==='unknown'}>Не знаю</option></select></label>
        <button class="button-secondary">Проверить совместимость</button>
        {fitmentError&&<p class="field-error" role="alert">{fitmentError}</p>}
        {vehicle&&!fitmentError&&<p class="fitment-result" role="status"><strong>{fitmentLabel}.</strong> Год: {year}, кондиционер: {ac==='yes'?'есть':ac==='no'?'нет':'неизвестно'}. {fitment==='unknown'&&'Данных недостаточно для подтверждения.'}</p>}
      </form></details>
      {product.variants.length>1&&<section class="variant-picker" aria-labelledby="variant-label"><h2 id="variant-label">{color?'Цвет подсветки':'Исполнение'}: <span>{variant?.label}</span></h2><div class="variant-options">{product.variants.map(v=>{const url=new URL(productHref(product,v),Astro.url);for(const key of ['vehicle','year','ac','version'])if(Astro.url.searchParams.get(key))url.searchParams.set(key,Astro.url.searchParams.get(key)!);return <a class:list={['variant-option',v.id===variant?.id&&'is-selected']} href={url.pathname+url.search} aria-current={v.id===variant?.id?'true':undefined}>{v.attributes.illumination&&<i style={`--swatch:${attributeDefinitions.illumination?.values.find(o=>o.value===v.attributes.illumination)?.color??'#888'}`}/>}<span>{v.label}</span></a>})}</div></section>}
      {product.kind==='bundle'&&<div class="bundle-fixed"><Icon name="box"/><p><strong>Фиксированный состав</strong><span>Исполнения уже выбраны. Состав комплекта не меняется.</span></p></div>}
      <div class="product-facts">{variant?.attributes.surface&&<span>Поверхность: <b>{attributeLabel('surface',variant.attributes.surface).toLowerCase()}</b></span>}<span>Артикул: <b>{variant?.article??'Фиксированный комплект'}</b></span></div>
      <div class="buy-box"><div class="price-row"><strong data-price-rubles={offer.priceRubles}>{money(offer.priceRubles)}</strong><span class:list={['stock',offer.available===0&&'preorder']}>{`${offer.available>0?'В наличии':'Предзаказ'}${product.isDemo?' · демо':''}`}</span></div>
        {offer.available===0&&<p class="preorder-explanation">{product.kind==='bundle'?'Одного из компонентов нет в наличии. Весь комплект оформляется как предзаказ.':'Товара пока нет в наличии.'} Без немедленной оплаты: сначала менеджер подтверждает срок и условия.</p>}
        <div class="buy-row"><div class="quantity js-only"><button type="button" data-quantity="-1" aria-label="Уменьшить количество">−</button><input id="product-quantity" type="number" min="1" max="99" step="1" value="1" aria-label="Количество"/><button type="button" data-quantity="1" aria-label="Увеличить количество">+</button></div><button class="button buy-button js-only" data-add-product={product.id} data-sku-id={variant?.id}>{offer.available>0?'В корзину':'В предзаказ'}<Icon name="cart"/></button></div>
        <p id="quantity-error" class="field-error" role="alert" hidden></p><p class="purchase-note">Тестовая покупка. Оплата и доставка — имитация.</p>
        <p class="delivery-line"><Icon name="box" size={19}/><a href="/info/delivery">СДЭК по России · стоимость при оформлении</a></p>
      </div>
    </section>
  </div>
  <div class="product-details-layout"><section class="product-description"><div class="product-tabs" aria-label="Разделы товара"><a href="#description">Описание</a><a href="#specifications">Характеристики</a><a href="#delivery">Доставка</a><a href="#reviews">Отзывы</a></div><section id="description"><h2>Описание</h2><p>{product.description}</p></section><section id="specifications"><h2>{product.kind==='bundle'?'Что входит в комплект':'Характеристики'}</h2>
    {componentRows?<><ul class="bundle-components">{componentRows.map(c=><li><a href={productHref(c.product,c.variant)}><img src={c.variant.image} width="720" height="480" loading="lazy" alt=""/><span>{c.product.name}<small>{c.variant.label} · {c.quantity} шт.</small></span></a><b>{money(multiplyRubles(c.variant.priceRubles,c.quantity))}</b></li>)}</ul><p class="bundle-price-note">Цена: сумма компонентов минус {((product.discountBps??0)/100)}% скидки комплекта. Остаток общий с отдельными деталями.</p></>:<dl class="spec-list">{Object.entries(variant?.attributes??product.attributes).map(([key,value])=><div><dt>{attributeDefinitions[key]?.label??key}</dt><dd>{attributeLabel(key,value)}</dd></div>)}<div><dt>Совместимость</dt><dd>{vehicle?fitmentLabel:'Укажите автомобиль для проверки'}</dd></div>{product.isDemo&&<div><dt>Данные товара</dt><dd>Демонстрационные</dd></div>}</dl>}
  </section><section id="delivery"><h2>Доставка и предзаказ</h2><p>Отправление из Махачкалы по России: СДЭК до пункта выдачи или курьером. Доставка обычного заказа и предзаказа рассчитывается отдельно. При отсутствии расчёта стоимость уточнит менеджер до оплаты.</p></section></section><aside class="product-help"><Icon name="car"/><h2>Сначала — точный подбор</h2><p>Проверяем модель, год выпуска и наличие кондиционера. Если сведений недостаточно, совместимость уточняется.</p><a href="#compatibility">Указать автомобиль <Icon name="arrow" size={17}/></a></aside></div>
  {reviews&&<Reviews productId={product.id} view={reviews} authenticated={Boolean(Astro.locals.shopSession?.email)}/>}
  <aside class="mobile-purchase js-only" aria-label="Действие покупки"><div><strong>{money(offer.priceRubles)}</strong><small>{offer.available>0?(product.isDemo?'Демонстрационная цена':'Выбранное исполнение'):'Предзаказ · без оплаты'}</small></div><button class="button" data-add-product={product.id} data-sku-id={variant?.id}>{offer.available>0?'В корзину':'В предзаказ'}<Icon name="arrow" size={18}/></button></aside>
  <dialog id="image-dialog" aria-labelledby="image-dialog-title"><div class="dialog-heading"><h2 id="image-dialog-title">{placeholder?'Изображение-заглушка':product.name}</h2><button data-close-dialog class="icon-button" aria-label="Закрыть изображение"><Icon name="close"/></button></div><img src={image} width="720" height="480" alt={media[0]?.alt||`${placeholder?'Изображение-заглушка: ':''}${product.name}`}/>{placeholder&&<p class="muted">Реальные фотографии этого исполнения появятся после наполнения каталога.</p>}</dialog>
</>:<section class="empty-panel missing-product"><Icon name="search" size={42}/><h1>{product?'Исполнение не найдено':'Товар не найден'}</h1><p>{product?'Такого исполнения у этого товара нет. Выберите доступный вариант в основной карточке.':'Проверьте адрес или найдите деталь в каталоге.'}</p><a class="button" href={product?`/product/${product.slug}`:'/catalog'}>{product?'Открыть товар':'Перейти в каталог'}<Icon name="arrow"/></a></section>}
</main>
<script>import '../../scripts/product.ts';</script>
</StoreLayout>
