---
import ManagerLayout from '../../../layouts/ManagerLayout.astro';
import ManagerAccess from '../../../components/ManagerAccess.astro';
import ProductImageLibrary from '../../../components/ProductImageLibrary.astro';
import '../../../styles/product-editor.css';
import '../../../styles/content.css';
import '../../../styles/content-editor.css';
---
<ManagerLayout title="Редактор материала" active="content"><section data-workspace="content-editor"><header class="dash-header"><div><a class="pe-back" data-content-back href="/manager/content">← К материалам</a><p class="dash-eyebrow">Страницы и статьи</p><h1 data-ce-title>Новый материал</h1></div><button type="button" class="dash-button" data-workspace-refresh>Загрузить сохранённое</button></header><ManagerAccess/>
 <div data-workspace-content hidden><p class="dash-message" data-ce-status></p><div class="pe-inline-actions"><button class="dash-button" type="button" data-ce-discard hidden>Сбросить черновик</button><button class="dash-button dash-danger" type="button" data-ce-archive hidden>Удалить материал</button><button class="dash-button" type="button" data-ce-restore hidden>Восстановить в черновик</button><a class="dash-button" data-ce-public hidden target="_blank" rel="noopener">Открыть на сайте</a></div>
 <ProductImageLibrary/>
 <dialog class="mgr-dialog" data-ce-image-dialog aria-labelledby="ce-image-title"><header class="mgr-dialog-head"><h2 id="ce-image-title">Фото в тексте</h2><button class="dash-button" type="button" data-ce-image-close>Закрыть</button></header><img data-ce-image-preview class="ce-image-preview" alt=""/><label class="dash-field">Описание изображения (alt)<input data-ce-image-alt maxlength="500"/></label><label class="dash-field">Размер<select data-ce-image-width><option value="100%">На ширину текста</option><option value="75%">75% ширины</option><option value="50%">Половина ширины</option></select></label><label class="dash-field" data-ce-caption-label>Подпись под фото<input data-ce-image-caption maxlength="500"/></label><button class="dash-button dash-primary" type="button" data-ce-image-apply>Вставить фото</button></dialog>
 <dialog class="mgr-dialog ce-preview-dialog" data-ce-preview aria-labelledby="ce-preview-title"><header class="mgr-dialog-head"><h2 id="ce-preview-title">Предпросмотр</h2><button class="dash-button" type="button" data-ce-preview-close>Закрыть</button></header><article><h1 data-ce-preview-heading></h1><p class="content-lead" data-ce-preview-summary></p><img class="ce-cover" data-ce-preview-cover hidden alt=""/><div class="content-prose" data-ce-preview-body></div><p class="dash-help" data-ce-preview-video></p></article></dialog>
 <dialog class="mgr-dialog" data-ce-taxonomy aria-labelledby="ce-tax-title"><header class="mgr-dialog-head"><h2 id="ce-tax-title">Новая категория</h2><button class="dash-button" type="button" data-ce-tax-close>Закрыть</button></header><form data-ce-tax-form novalidate><label class="dash-field">Название<input name="name" required maxlength="100"/></label><label class="dash-field">Адрес<input name="slug" required maxlength="160" pattern="[a-z0-9]+(-[a-z0-9]+)*"/></label><p class="dash-error" data-ce-tax-error role="alert"></p><button class="dash-button dash-primary">Создать</button></form></dialog>
 <form data-ce-form novalidate><fieldset data-ce-fields class="pe-fields"><section class="dash-panel pe-section"><h2>Основное</h2><div class="pe-stack" data-ce-main></div></section><section class="dash-panel pe-section" data-ce-article><h2>Обложка статьи</h2><div data-ce-cover></div></section>
 <section class="dash-panel pe-section ce-writing"><div class="dash-section-head"><h2>Текст</h2><span class="dash-help" data-ce-count></span></div><div class="pe-inline-actions ce-photo-actions"><button type="button" class="dash-button" data-ce-upload="inline">Загрузить фото</button><button type="button" class="dash-button" data-ce-library="inline">Фото из библиотеки</button><button type="button" class="dash-button" data-ce-image-settings>Параметры фото</button></div><p class="dash-help">Установите курсор в нужное место. Подпись можно написать обычным текстом под изображением.</p><div class="ce-editor"><div data-ce-quill></div></div><p class="dash-help" data-ce-upload-status role="status"></p></section>
 <details class="dash-panel pe-details" data-ce-article><summary>Категория, теги и связанные товары</summary><div class="pe-stack" data-ce-relations></div></details><details class="dash-panel pe-details" data-ce-article><summary>Видео</summary><div class="pe-grid" data-ce-video></div></details><details class="dash-panel pe-details"><summary>Адрес страницы и SEO</summary><div class="pe-stack" data-ce-seo></div></details><details class="dash-panel pe-details"><summary>Публикация и дополнительные настройки</summary><div class="pe-stack" data-ce-settings></div></details></fieldset>
 <div class="pe-actions"><span data-ce-save-hint role="status">Изменения не сохранены</span><div><button type="button" class="dash-button" data-ce-show-preview>Предпросмотр</button><button type="button" class="dash-button" data-ce-save>Сохранить черновик</button><button type="submit" class="dash-button dash-primary" data-ce-publish>Опубликовать</button></div></div></form><input type="file" data-ce-file accept="image/jpeg,image/png,image/webp" hidden/>
 </div></section><script>import '../../../scripts/content-editor';</script></ManagerLayout>
