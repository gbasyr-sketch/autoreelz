---
import StoreLayout from '../layouts/StoreLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import {getCatalog} from '../server/catalog';
import {getFavorites} from '../server/social';
const catalog=await getCatalog();
const {products,offerFor}=catalog;
const favorites=Astro.locals.shopSession?await getFavorites(Astro.locals.shopSession):{authenticated:false,productIds:[]};
const ids=new Set(favorites.productIds);
const visibleCount=products.filter(p=>ids.has(p.id)&&offerFor(p)).length;
---
<StoreLayout catalog={catalog} title="Избранное"><main id="main" class="container page-pad" data-favorites-page><div class="page-intro"><p class="eyebrow">Ваш выбор</p><h1>Избранное</h1><p data-favorites-note>{favorites.authenticated?'Избранное сохранено в вашем аккаунте и доступно на других устройствах.':'Избранное сохранено в этом браузере. После входа оно объединится с вашим аккаунтом.'}</p>{!favorites.authenticated&&<a class="text-link" href="/account">Войти по email</a>}</div><div class="notice error" data-favorites-error role="alert" hidden></div><p class="favorite-state" data-favorites-count>Доступных товаров в избранном: {visibleCount}</p><button class="button-secondary js-only" type="button" data-retry-favorites>Обновить избранное</button><div class="empty-panel" data-favorites-empty hidden={visibleCount>0}><Icon name="heart" size={40}/><h2>Сохраните то, что нравится</h2><p>Нажмите на сердечко у товара — он появится здесь. Неопубликованные товары временно не показываются.</p><a href="/catalog" class="button">Посмотреть каталог <Icon name="arrow"/></a></div><div class="cards-grid">{products.map(p=>{const offer=offerFor(p);return offer&&<div data-product-id={p.id} hidden={!ids.has(p.id)}><ProductCard product={p} offer={offer} catalog={catalog}/></div>})}</div></main></StoreLayout>
