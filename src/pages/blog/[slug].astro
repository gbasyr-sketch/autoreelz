---
import StoreLayout from '../../layouts/StoreLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import {getCatalog} from '../../server/catalog';
import Icon from '../../components/Icon.astro';
import {getContent} from '../../server/content';
import {resolveContent,textParagraphs,contentDate} from '../../lib/content';
import '../../styles/content.css';
const catalog=await getCatalog();
const content=await getContent(),resolved=resolveContent(content,'article',Astro.params.slug??'');
if(resolved?.redirect)return Astro.redirect(`/blog/${resolved.slug}`,301);
const article=content.articles.find(a=>a.id===resolved?.id);if(!article)Astro.response.status=404;
---
<StoreLayout catalog={catalog} content={content} title={article?.seoTitle??article?.title??'Статья не найдена'} description={article?.metaDescription??article?.excerpt}>
<main id="main" class="container content-page"><nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><a href="/blog">Блог</a>{article&&<a href={`/blog/category/${article.category.slug}`}>{article.category.name}</a>}</nav>
{article?<article class="content-article blog-article"><header><div class="article-meta"><span>{article.category.name}</span>{article.publishedAt&&<time datetime={article.publishedAt}>{contentDate(article.publishedAt)}</time>}</div><h1>{article.title}</h1>{article.excerpt&&<p class="content-lead">{article.excerpt}</p>}{article.isDemo&&<p class="notice">Демонстрационный материал для проверки блога. Он не подтверждает свойства или совместимость конкретного изделия.</p>}</header>{article.coverUrl&&<img class="article-cover" src={article.coverUrl} alt={article.title} width="960" height="640"/>}<div class="content-prose">{textParagraphs(article.body).map(text=><p>{text}</p>)}</div>
{article.video&&<section class="article-video" aria-label={`Видео ${article.video.provider}`} data-video-embed={article.video.embedUrl}><div data-video-placeholder><Icon name="display" size={40}/><h2>{article.videoMetadata?.title||`Видео на ${article.video.provider}`}</h2>{article.videoMetadata?.description&&<p>{article.videoMetadata.description}</p>}{article.videoMetadata?.thumbnailUrl&&<img src={article.videoMetadata.thumbnailUrl} alt={article.videoMetadata.title||`Превью видео ${article.video.provider}`} width="960" height="540" loading="lazy"/>}<p>Плеер загрузится с внешнего сервиса после нажатия.</p><button class="button js-only" type="button" data-load-video>Показать видео</button><a class="content-read-link" href={article.video.watchUrl} target="_blank" rel="noopener noreferrer">Открыть на {article.video.provider} <Icon name="arrow" size={17}/></a></div></section>}
{article.invalidVideo&&<p class="notice warning">Видео пока недоступно. Ссылка в материале требует уточнения.</p>}
{(article.relatedProductIds?.length??0)>0&&<section><h2>Товары из материала</h2><div class="cards-grid">{article.relatedProductIds?.flatMap(id=>{const p=catalog.products.find(p=>p.id===id),o=p&&catalog.offerFor(p);return p&&o?[<ProductCard product={p} offer={o} catalog={catalog}/>]:[]})}</div></section>}
{article.tags.length>0&&<nav class="content-tags" aria-label="Теги статьи">{article.tags.map(t=><a href={`/blog/tag/${t.slug}`}>#{t.name}</a>)}</nav>}<a class="button-secondary" href="/blog">Все материалы <Icon name="arrow" size={18}/></a></article>:<section class="empty-panel"><h1>Статья не найдена</h1><p>Материал не опубликован или его адрес изменился.</p><a class="button-secondary" href="/blog">Вернуться в блог</a></section>}
</main><script>document.querySelectorAll<HTMLElement>('[data-video-embed]').forEach(box=>box.querySelector('[data-load-video]')?.addEventListener('click',()=>{const frame=document.createElement('iframe');frame.src=box.dataset.videoEmbed!;frame.title='Видеоматериал статьи';frame.allow='fullscreen; encrypted-media; picture-in-picture';frame.allowFullscreen=true;frame.referrerPolicy='strict-origin-when-cross-origin';frame.setAttribute('sandbox','allow-scripts allow-same-origin allow-presentation');const status=document.createElement('p');status.className='field-help';status.textContent='Если плеер не открылся, воспользуйтесь ссылкой на сервис.';const link=box.querySelector('a');box.replaceChildren(frame,status);if(link)box.append(link);}));</script></StoreLayout>
