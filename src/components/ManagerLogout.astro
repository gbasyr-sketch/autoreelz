<div class="staff-exit-wrap"><button type="button" class="staff-exit-button" data-staff-logout>Выйти</button><p class="staff-exit-error" data-staff-logout-error role="alert" hidden></p></div>
<style>
.staff-exit-wrap{display:grid;gap:8px}.staff-exit-button{font:inherit;font-size:13px;font-weight:600;background:#fff;color:#1d1d1b;border:1px solid #deded7;border-radius:7px;min-height:44px;padding:9px 16px;cursor:pointer}.staff-exit-button:hover{background:#f5f5ef}.staff-exit-button:disabled{opacity:.6;cursor:wait}.staff-exit-error{color:#951619;font-size:12px;line-height:1.7;max-width:300px;margin:0}.staff-exit-button:focus-visible{outline:3px solid #cb181a;outline-offset:3px}
</style>
<style is:global>html[data-staff-exiting] [data-dash-content],html[data-staff-exiting] [data-manager-content],html[data-staff-exiting] [data-workspace-content],html[data-staff-exiting] [data-owner-content]{display:none!important}</style>
<script>import '../scripts/staff-session';</script>
