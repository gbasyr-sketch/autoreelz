---
import ManagerLogout from '../components/ManagerLogout.astro';
import Icon from '../components/Icon.astro';
import {setting} from '../server/config';
import '../styles/dashboard.css';
interface Props{title:string}
const{title}=Astro.props;
const cmsUrl=setting('STORE_MODE','local-test')==='local-test'?`http://127.0.0.1:${setting('CMS_PORT','28055')}/admin`:'/cms/admin';
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.locals.seoIndexable=false;
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive"/><meta name="csrf-token" content={Astro.locals.shopSession?.csrfToken}/><title>{title} · AUTO REELZ</title><link rel="icon" href="/brand/favicon.svg" type="image/svg+xml"/></head>
<body class="dashboard-body"><a class="dash-skip" href="#dashboard-main">К содержимому</a><div class="dash-shell"><aside class="dash-sidebar"><a href="/manager" class="dash-brand" aria-label="AUTO REELZ — обзор магазина"><img src="/brand/logo.svg" width="148" height="30" alt="AUTO REELZ"/></a><span class="dash-caption">Кабинет владельца</span><nav aria-label="Управление магазином"><a href="/manager" aria-current="page"><Icon name="grid" size={19}/>Обзор</a><a href="/manager/orders"><Icon name="cart" size={19}/>Заказы</a><a href="/manager/orders#manager-stock"><Icon name="box" size={19}/>Склад</a><a href={`${cmsUrl}/content/ar_products`}><Icon name="console" size={19}/>Товары в CMS</a><a href="/manager/reviews"><Icon name="heart" size={19}/>Отзывы</a><a href={`${cmsUrl}/content/ar_articles`}><Icon name="display" size={19}/>Статьи</a><a href="/manager/content"><Icon name="panel" size={19}/>Описания</a></nav><div class="dash-sidebar-end"><a href="/" target="_blank" rel="noopener">Открыть магазин <Icon name="arrow" size={16}/></a><a href={cmsUrl}>Открыть CMS</a><ManagerLogout/></div></aside><main id="dashboard-main" class="dash-main" data-dashboard data-cms-url={cmsUrl}><slot/></main></div></body></html>
