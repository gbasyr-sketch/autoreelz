---
import '../../styles/content-editor.css';
import ManagerLayout from '../../layouts/ManagerLayout.astro';
import ManagerAccess from '../../components/ManagerAccess.astro';
if(Astro.url.searchParams.has('product'))return Astro.redirect('/manager/descriptions?product='+encodeURIComponent(Astro.url.searchParams.get('product')!),302);
---
<ManagerLayout title="Контент" active="content"><section data-workspace="content-list"><header class="dash-header"><div><p class="dash-eyebrow">Материалы магазина</p><h1>Контент</h1></div><div class="dash-header-actions"><a class="dash-button dash-primary" data-content-new href="/manager/content/edit?kind=article">+ Написать статью</a><button type="button" class="dash-button" data-workspace-refresh>Обновить</button></div></header><ManagerAccess/><div data-workspace-content hidden><nav class="mgr-service-tabs" aria-label="Разделы контента"><a class="dash-button" data-content-tab="article" href="/manager/content?kind=article">Статьи</a><a class="dash-button" data-content-tab="page" href="/manager/content?kind=page">Страницы магазина</a><a class="dash-button" href="/manager/descriptions">Описания товаров</a></nav><div class="mgr-filter-panel"><label class="dash-field mgr-search">Найти материал<input type="search" data-content-search placeholder="Заголовок или адрес страницы"/></label><label class="dash-field">Показать<select data-content-status><option value="active">Все активные</option><option value="draft">Черновики и правки</option><option value="published">Опубликованные</option><option value="archived">Удалённые</option></select></label></div><section class="dash-panel"><div class="dash-section-head"><h2 data-content-heading>Статьи</h2><span data-content-count></span></div><div data-content-list></div><nav class="mgr-pagination" data-content-pagination aria-label="Страницы списка"></nav></section></div></section><script>import '../../scripts/content-list';</script></ManagerLayout>
