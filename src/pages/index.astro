---
import StoreLayout from '../layouts/StoreLayout.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import {getCatalog} from '../server/catalog';
import {getContent} from '../server/content';
import {getHomeReviews} from '../server/home';
import {setting} from '../server/config';
import {homeSelection,demoProductReviews} from '../lib/home';
import {contentDate,textParagraphs} from '../lib/content';
import '../styles/home.css';
const [catalog,content,publishedReviews]=await Promise.all([getCatalog(),getContent(),getHomeReviews()]);
const{featured,categoryCards,heroItem,articles,about}=homeSelection(catalog,content);
const bundleCategory=catalog.categories.find(c=>catalog.products.some(p=>p.category===c.slug&&p.kind==='bundle'));
const showDemoReviews=['local-test','staging'].includes(setting('STORE_MODE','local-test'))&&publishedReviews.length===0;
const reviews=showDemoReviews?demoProductReviews(catalog,setting('STORE_MODE','local-test')):publishedReviews;
const aboutParagraphs=about?textParagraphs(about.body).slice(0,2):['AUTO REELZ — отдельные детали автомобильного интерьера и готовые комплекты. Подбирайте исполнение по модели автомобиля, году выпуска и наличию кондиционера.'];
const heroImage=heroItem?.offer.variant?.image??heroItem?.product.image??'/images/placeholder-console.svg';
const heroImageReal=Boolean((heroItem?.offer.variant?.media??heroItem?.product.media)?.length);
const currentYear=new Date().getFullYear();
---
<StoreLayout catalog={catalog} content={content} title="Детали автомобильного интерьера" active="home">
<main id="main" class="container home-main">
 <h1 class="home-visually-hidden">AUTO REELZ — детали автомобильного интерьера и готовые комплекты</h1>
 <section class="home-hero" data-hero-carousel role="region" aria-roledescription="карусель" aria-label="Подборки AUTO REELZ">
  <div data-hero-stage>
   <article class="hero-slide hero-slide-bundles" data-hero-slide role="group" aria-roledescription="слайд" aria-label="1 из 2: Готовые комплекты">
    <div class="hero-copy"><p class="eyebrow">Готовые комплекты</p><h2>Детали, собранные<br/>в одно решение.</h2><p class="hero-text">Фиксированный состав из конкретных исполнений. Посмотрите, что входит в комплект.</p><a class="button-secondary" href={bundleCategory?`/catalog?category=${bundleCategory.slug}`:'/catalog'}>Выбрать комплект <Icon name="arrow"/></a></div>
    <div class="hero-visual hero-kit"><img src="/images/placeholder-kit.svg" width="720" height="480" fetchpriority="high" alt="Иллюстрация упаковки комплекта"/><span class="hero-image-note">Изображение-заглушка</span></div>
   </article>
   <article class="hero-slide hero-slide-parts" data-hero-slide role="group" aria-roledescription="слайд" aria-label="2 из 2: Детали для вашего автомобиля" hidden>
    <div class="hero-copy"><p class="eyebrow">Ваш автомобиль. Ваш интерьер.</p><h2>Обновление салона<br/>начинается с деталей.</h2><p class="hero-text">Консоли, блоки отопителя, ручки КПП и воздуховоды. Выберите подходящее исполнение.</p><a class="button" href="#selection">Подобрать детали <Icon name="arrow"/></a></div>
    <div class="hero-visual hero-product"><img src={heroImage} width="720" height="480" loading="lazy" alt={heroImageReal?heroItem?.product.name:'Изображение-заглушка детали'}/>{!heroImageReal&&<span class="hero-image-note">Изображение-заглушка</span>}</div>
   </article>
  </div>
  <div class="hero-controls js-only"><div class="hero-dots" role="group" aria-label="Выбрать слайд"><button type="button" data-hero-dot="0" aria-label="Готовые комплекты" aria-pressed="true"></button><button type="button" data-hero-dot="1" aria-label="Детали для автомобиля" aria-pressed="false"></button></div><span class="hero-counter" data-hero-counter aria-live="polite" aria-atomic="true">1 / 2</span><div class="hero-arrows"><button type="button" data-hero-step="-1" aria-label="Предыдущий слайд"><Icon name="arrow" class="arrow-back"/></button><button type="button" data-hero-step="1" aria-label="Следующий слайд"><Icon name="arrow"/></button></div></div>
 </section>
 <form class="finder" action="/catalog" id="selection"><div class="finder-intro"><h2>Начнём с автомобиля</h2><p>Чтобы найти подходящие детали</p></div><label class="field">Модель<select name="vehicle" required><option value="">Выберите автомобиль</option>{catalog.vehicles.map(v=><option value={v.slug}>{v.name}</option>)}</select></label><label class="field">Год выпуска<input name="year" inputmode="numeric" type="number" min="1970" max={currentYear} placeholder="Например, 2015" required/></label><label class="field">Кондиционер<select name="ac" required><option value="">Выберите</option><option value="yes">Есть</option><option value="no">Нет</option><option value="unknown">Не знаю</option></select></label><button class="button">Подобрать <Icon name="arrow"/></button></form>
 <p class="finder-note">Подбор покажет только подтверждённую совместимость. Если данных недостаточно, предложим уточнение.</p>
 <section class="home-section" aria-labelledby="categories-title"><div class="section-heading"><div><p class="eyebrow">С чего начнём?</p><h2 id="categories-title">Популярные категории</h2></div><a href="/catalog">Все категории <Icon name="arrow" size={18}/></a></div><div class="home-categories">{categoryCards.map(({category,item},index)=><a class={`home-category tone-${index%6}`} href={`/catalog?category=${category.slug}`}><div class="home-category-copy"><h3>{category.name}</h3><span>В каталог <Icon name="arrow" size={18}/></span></div><img src={item.offer.variant?.image??item.product.image} alt="" width="360" height="360" loading="lazy"/></a>)}</div></section>
 <section class="home-section" aria-labelledby="products-title"><div class="section-heading"><div><p class="eyebrow">Знакомство с каталогом</p><h2 id="products-title">Детали вашего интерьера</h2></div><a href="/catalog">Смотреть всё <Icon name="arrow" size={18}/></a></div>{featured.some(({product})=>product.isDemo)&&<p class="home-demo-note">Демотовары подписаны: их цены и наличие — примеры для проверки магазина.</p>}<div class="cards-grid">{featured.map(({product,offer})=><ProductCard product={product} offer={offer} catalog={catalog}/>)}</div></section>
 <section class="home-section home-reviews" aria-labelledby="reviews-title"><div class="section-heading"><div><p class="eyebrow">Впечатления покупателей</p><h2 id="reviews-title">Отзывы о товарах</h2></div></div>{showDemoReviews&&<p class="home-demo-note review-demo-note">Ниже — вымышленные примеры для оценки оформления. Это не отзывы реальных покупателей.</p>}
  <div class="reviews-layout"><aside class="reviews-intro"><Icon name="heart" size={32}/><h3>Ваш опыт помогает<br/>с выбором.</h3><p>После получения товара можно оставить отзыв в его карточке. Публикуем отзывы после проверки.</p></aside>
  {reviews.length?<div class="home-rail-shell" data-home-rail><div class="home-review-track" data-rail-track tabindex="0" aria-label="Отзывы, можно прокручивать">{reviews.map(review=><article class="home-review" data-home-review><div class="review-person"><span class="review-avatar" aria-hidden="true">{Array.from(review.authorName)[0]}</span><div><h3>{review.authorName}</h3>{review.isDemo?<span class="review-demo-label">Демонстрационный отзыв</span>:<span>Отзыв о товаре</span>}</div></div><p class="review-body">{review.body.length>280?review.body.slice(0,277)+'…':review.body}</p>{review.createdAt&&<time datetime={review.createdAt}>{contentDate(review.createdAt)}</time>}{review.productSlug&&<a class="content-read-link" href={`/product/${review.productSlug}#reviews`}>{review.productName} <Icon name="arrow" size={16}/></a>}</article>)}</div><div class="rail-controls js-only"><button type="button" data-rail-step="-1" aria-label="Предыдущие отзывы"><Icon name="arrow" class="arrow-back"/></button><button type="button" data-rail-step="1" aria-label="Следующие отзывы"><Icon name="arrow"/></button></div></div>:<div class="reviews-empty"><h3>Отзывы появятся после первых покупок</h3><p>Здесь будет опыт покупателей AUTO REELZ — о выборе и использовании деталей.</p></div>}
  </div>
 </section>
 <section class="home-section home-about" aria-labelledby="about-title"><div class="about-visual" aria-hidden="true"><span>AUTO REELZ</span><Icon name="car" size={120}/><p>Детали вашего интерьера</p></div><div class="about-copy"><p class="eyebrow">О магазине</p><h2 id="about-title">AUTO REELZ —<br/>детали для вашего салона.</h2>{aboutParagraphs.map(p=><p>{p}</p>)}<a class="text-link" href="/info/about">Подробнее о магазине <Icon name="arrow" size={18}/></a></div></section>
 <section class="home-section home-blog" aria-labelledby="blog-title"><div class="section-heading"><div><p class="eyebrow">Разбираемся в деталях</p><h2 id="blog-title">Статьи и советы</h2></div><a href="/blog">Все статьи <Icon name="arrow" size={18}/></a></div>
 {articles.length?<div class="home-rail-shell" data-home-rail><div class="home-article-track" data-rail-track tabindex="0" aria-label="Статьи, можно прокручивать">{articles.map((a,i)=><article class="home-article"><a class={`home-article-cover article-tone-${i%3}`} href={`/blog/${a.slug}`} tabindex="-1" aria-hidden="true">{a.coverUrl?<img src={a.coverUrl} alt="" width="600" height="450" loading="lazy"/>:<><Icon name={['car','box','vent'][i%3]!} size={92}/><span>AUTO REELZ / ЖУРНАЛ</span></>}</a><div class="home-article-copy"><p class="article-category">{a.category.name}</p>{a.isDemo&&<p class="review-demo-label">Демонстрационный материал</p>}<h3><a href={`/blog/${a.slug}`}>{a.title}</a></h3><p>{a.excerpt}</p>{a.publishedAt&&<time datetime={a.publishedAt}>{contentDate(a.publishedAt)}</time>}<a class="content-read-link" href={`/blog/${a.slug}`}>Читать статью <Icon name="arrow" size={17}/></a></div></article>)}</div><div class="rail-controls js-only"><button type="button" data-rail-step="-1" aria-label="Предыдущие статьи"><Icon name="arrow" class="arrow-back"/></button><button type="button" data-rail-step="1" aria-label="Следующие статьи"><Icon name="arrow"/></button></div></div>:<p class="home-empty">Статьи готовятся. Новые материалы появятся здесь после публикации в блоге.</p>}
 </section>
</main>
<script>import '../scripts/home.ts';</script>
</StoreLayout>
