---
import StoreLayout from '../../layouts/StoreLayout.astro';
import '../../styles/commerce.css';
Astro.response.headers.set('Cache-Control','private, no-store');
---
<StoreLayout title="Ваш заказ"><main id="main" class="container commerce-page" data-commerce="order" data-order-id={Astro.params.id}>
<nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/account">Личный кабинет</a><span>Заказ</span></nav>
<div class="commerce-heading"><div><p class="eyebrow">Тестовая покупка</p><h1 data-order-title>Ваш заказ</h1></div><button class="button-secondary" data-reload-order type="button">Обновить статус</button></div>
<div class="notice error" data-page-error role="alert" tabindex="-1" hidden></div><div data-page-loading class="commerce-loading" role="status">Загружаем заказ…</div>
<nav data-related-orders hidden class="related-orders" aria-label="Заказы этой покупки"></nav><div data-order-content></div>
<noscript><p class="notice warning">Для просмотра заказа включите JavaScript.</p></noscript>
</main><script>import '../../scripts/commerce.ts';</script></StoreLayout>
