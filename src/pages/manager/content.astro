---
import ManagerLayout from '../../layouts/ManagerLayout.astro';
import ManagerAccess from '../../components/ManagerAccess.astro';
import {setting} from '../../server/config';
const cms=setting('STORE_MODE','local-test')==='local-test'?`http://127.0.0.1:${setting('CMS_PORT','28055')}/admin`:'/cms/admin';
if(Astro.url.searchParams.has('product'))return Astro.redirect('/manager/descriptions?product='+encodeURIComponent(Astro.url.searchParams.get('product')!),302);
---
<ManagerLayout title="Контент" active="content"><section data-workspace="content"><header class="dash-header"><div><p class="dash-eyebrow">Материалы магазина</p><h1>Контент</h1></div></header><ManagerAccess/><div data-workspace-content hidden><div class="mgr-link-grid"><a class="dash-panel mgr-link-panel" href={`${cms}/content/ar_articles`}><h2>Статьи</h2><p>Материалы блога, обложки и видео</p><span>Редактировать в CMS →</span></a><a class="dash-panel mgr-link-panel" href={`${cms}/content/ar_pages`}><h2>Страницы магазина</h2><p>О магазине, доставка, контакты и документы</p><span>Редактировать в CMS →</span></a><a class="dash-panel mgr-link-panel" href="/manager/descriptions"><h2>Описания товаров</h2><p>Предварительный просмотр и применение текстов</p><span>Открыть инструмент →</span></a></div></div></section><script>import {managerPage} from '../../scripts/manager-page';const root=document.querySelector<HTMLElement>('[data-workspace="content"]');if(root){const page=managerPage(root,async signal=>{await page.get('/api/manager/access',signal);return()=>{};});void page.reload();}</script></ManagerLayout>
