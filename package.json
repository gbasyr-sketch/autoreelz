{
  "name": "autoreelz-new-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AUTO REELZ independent storefront — local demo",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "astro": "7.3.3",
    "decimal.js": "10.6.0",
    "leaflet": "1.9.4",
    "pg": "8.23.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/leaflet": "1.9.21",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 14322",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 14322",
    "check": "astro check",
    "test": "node --test tests/*.test.ts",
    "env:up": "node scripts/setup-local.mjs",
    "cms:seed": "node scripts/seed-cms.mjs",
    "cms:export": "node scripts/export-cms.mjs",
    "test:cms": "node tests/cms-schema.mjs && node tests/cms-permissions.mjs",
    "test:cms:browser": "node tests/cms-browser.mjs"
  }
}
