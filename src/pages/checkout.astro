---
import StoreLayout from '../layouts/StoreLayout.astro';
import '../styles/commerce.css';
import {shippingProvider} from '../server/shipping-policy';
import {setting} from '../server/config';
const mapProvider=setting('PICKUP_MAP_PROVIDER','osm');
const mapKey=mapProvider==='yandex'?setting('YANDEX_MAPS_API_KEY'):'';
const deliveryProvider=shippingProvider();
Astro.response.headers.set('Cache-Control','private, no-store');
---
<StoreLayout title="Оформление заказа"><main id="main" class="container commerce-page" data-commerce="checkout">
<nav class="breadcrumbs" aria-label="Хлебные крошки"><a href="/cart">Корзина</a><span>Оформление</span></nav>
<div class="commerce-heading"><div><p class="eyebrow">Тестовая покупка</p><h1>Оформление заказа</h1></div></div>
<p class="commerce-lead">Сначала проверьте состав и стоимость доставки. Реальные платежи и отправления отключены.</p>
<ol class="checkout-steps" aria-label="Шаги оформления"><li aria-current="step" data-step-contact><span>1</span> Получатель и доставка</li><li data-step-review><span>2</span> Проверка заказа</li></ol>
<div class="notice error" data-page-error role="alert" tabindex="-1" hidden></div>
<div data-page-loading class="commerce-loading" role="status">Проверяем корзину…</div>
<div data-checkout-empty hidden class="empty-panel"><h2>Корзина пока пуста</h2><p>Выберите детали в каталоге, чтобы оформить заказ.</p><a class="button" href="/catalog">В каталог</a></div>
<div class="commerce-grid" data-checkout-content hidden>
<form class="commerce-panel commerce-form" id="checkout-form">
<fieldset><legend>Получатель</legend><label class="field">Имя и фамилия<input name="name" autocomplete="name" required minlength="2" maxlength="100"/></label><div class="form-pair"><label class="field">Телефон<input name="phone" type="tel" autocomplete="tel" required minlength="10" maxlength="25" placeholder="+7 999 123-45-67"/></label><label class="field">Email<input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.ru"/></label></div><p class="field-help">После подтверждения email по коду ваши заказы появятся в личном кабинете.</p></fieldset>
<fieldset data-shipping-provider={deliveryProvider}><legend>Доставка</legend>
{deliveryProvider==='cdek'?<div class="delivery-options" role="group" aria-label="Выберите тип доставки"><label><input type="radio" name="method" value="courier"/>СДЭК — доставка до двери</label><label><input type="radio" name="method" value="pickup_point" checked/>СДЭК — доставка до пункта выдачи</label></div>:<label class="field">Способ получения<select name="method"><option value="pickup_point">СДЭК — пункт выдачи</option><option value="courier">СДЭК — курьер</option></select></label>}
<label class="field">Город или населённый пункт<input name="city" autocomplete="address-level2" required minlength="2" maxlength="100" aria-describedby="city-help"/></label>
{deliveryProvider==='cdek'&&<>
<p class="field-help" id="city-help">Введите полное название, затем выберите населённый пункт и регион из списка.</p>
<div class="cdek-controls" data-cdek-controls>
<button class="button-secondary" type="button" data-find-city>Найти город</button>
<label class="field">Населённый пункт СДЭК<select name="cityCode" required><option value="">Сначала найдите город</option></select></label>
<div class="cdek-controls" data-point-controls hidden>
<label class="field">Поиск ПВЗ по улице или коду<input name="pointSearch" type="search" autocomplete="off"/></label>
<button class="text-link pickup-list-link" type="button" data-select-from-list>Выбрать ПВЗ из списка</button>
<div class="delivery-cost-preview" data-delivery-cost-preview role="status" aria-live="polite">Выберите ПВЗ — покажем стоимость доставки.</div>
<div class="pickup-map" data-pickup-map data-map-provider={mapProvider} data-yandex-api-key={mapKey||undefined} role="region" aria-label="Карта пунктов выдачи СДЭК"><p class="field-help">Карта появится после выбора города.</p></div><p class="field-help" data-map-status role="status" aria-live="polite"></p>
<label class="field">Пункт выдачи СДЭК<select name="pointCode" required><option value="">Сначала выберите город</option></select></label>
<div class="form-pair"><label class="field">Код ПВЗ<input name="selectedPointCode" readonly placeholder="Выберите пункт выдачи"/></label><label class="field">Адрес пункта выдачи<input name="selectedPointAddress" readonly placeholder="Выберите пункт выдачи"/></label></div>
<p class="field-help" data-point-details></p>
<button class="button-secondary" type="button" data-more-points hidden>Показать ещё пункты</button>
</div>
</div>
<p class="field-help" data-shipping-status role="status" aria-live="polite"></p>
<p class="notice error" data-shipping-error role="alert" tabindex="-1" hidden></p>
<label class="manual-delivery"><input type="checkbox" name="manualDelivery"/>Указать адрес вручную — стоимость уточнит менеджер</label>
</>}
<label class="field" data-address-field><span data-address-label>Адрес пункта выдачи</span><input name="address" autocomplete="street-address" required minlength="3" maxlength="300"/><span class="field-help" data-delivery-cost-preview role="status" aria-live="polite"></span></label>
<p class="field-help">{deliveryProvider==='cdek'?'Стоимость рассчитывает СДЭК по упаковке вашего заказа. Если расчёт недоступен, менеджер уточнит сумму до оплаты.':'Тариф тестовый; если данных упаковки недостаточно, стоимость уточнит менеджер до оплаты.'}</p>
</fieldset>
<p class="field-help">Используйте вымышленные контакты для проверки. Данные формы сохраняются при расчёте заказа. <a href="/info/personal-data" target="_blank" rel="noopener">Политика обработки персональных данных</a> и <a href="/info/privacy" target="_blank" rel="noopener">конфиденциальность</a> пока находятся в подготовке к реальным продажам. Рекламные рассылки не подключены.</p>
<button class="button" type="submit">Проверить заказ и доставку</button>
</form>
<aside class="commerce-panel commerce-summary"><h2>Ваша корзина</h2><div data-checkout-summary></div><p class="field-help">Если части количества не хватает, вся строка переносится в предзаказ. Состав и цены проверяются ещё раз при оформлении.</p><a class="text-link" href="/cart">Изменить корзину</a></aside>
</div>
<section data-quote-review hidden aria-labelledby="review-title" class="quote-review"><div class="commerce-heading"><h2 id="review-title" tabindex="-1">Проверьте перед оформлением</h2><button class="button-secondary" type="button" data-edit-checkout>Изменить данные</button></div><div data-quote-contact class="notice"></div><div data-quote-groups class="quote-groups"></div><p class="field-help" data-quote-validity></p><p class="notice warning">Это тестовый заказ. Деньги не списываются. Предзаказ можно оплатить после согласования условий с менеджером.</p><div class="checkout-confirmations" data-checkout-confirmations></div><button class="button" type="button" data-confirm-checkout>Оформить тестовый заказ</button></section>
<noscript><p class="notice warning">Для оформления включите JavaScript.</p></noscript>
</main><script>import '../scripts/commerce.ts';</script></StoreLayout>
