---
import ManagerLogout from '../components/ManagerLogout.astro';
import Icon from '../components/Icon.astro';
import {setting} from '../server/config';
import '../styles/dashboard.css';
import '../styles/commerce.css';
import '../styles/owner-tools.css';
import '../styles/manager-workspace.css';
interface Props{title:string;active?:'overview'|'orders'|'stock'|'products'|'reviews'|'content'|'service'}
const{title,active='overview'}=Astro.props;
const cmsUrl=setting('STORE_MODE','local-test')==='local-test'?`http://127.0.0.1:${setting('CMS_PORT','28055')}/admin`:'/cms/admin';
const navigation=[['overview','/manager','grid','Обзор'],['orders','/manager/orders','cart','Заказы'],['stock','/manager/stock','box','Склад'],['products','/manager/products','console','Товары'],['reviews','/manager/reviews','heart','Отзывы'],['content','/manager/content','display','Контент'],['service','/manager/service','panel','Служебное']];
Astro.response.headers.set('Cache-Control','private, no-store');Astro.locals.seoIndexable=false;
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive"/><meta name="csrf-token" content={Astro.locals.shopSession?.csrfToken}/><title>{title} · AUTO REELZ</title><link rel="icon" href="/brand/favicon.svg" type="image/svg+xml"/></head>
<body class="dashboard-body"><a class="dash-skip" href="#dashboard-main">К содержимому</a><div class="dash-shell"><aside class="dash-sidebar" data-manager-menu data-menu-open="false"><div class="mgr-brand-row"><a href="/manager" class="dash-brand" aria-label="AUTO REELZ — обзор магазина"><img src="/brand/logo.svg" width="148" height="30" alt="AUTO REELZ"/></a><button class="dash-button mgr-menu-toggle" type="button" aria-expanded="false" aria-controls="manager-navigation" data-menu-toggle><Icon name="menu" size={18}/>Меню</button></div><span class="dash-caption">Кабинет владельца</span><nav id="manager-navigation" aria-label="Управление магазином">{navigation.map(([key,href,icon,label])=><a href={href} aria-current={active===key?'page':undefined}><Icon name={icon!} size={19}/>{label}</a>)}</nav><div class="dash-sidebar-end"><a href="/" target="_blank" rel="noopener">Открыть магазин <Icon name="arrow" size={16}/></a><a href={cmsUrl}>Открыть CMS</a><ManagerLogout/></div></aside><main id="dashboard-main" class="dash-main" data-dashboard={active==='overview'?true:undefined} data-manager-shell data-cms-url={cmsUrl}><slot/></main></div><script>import '../scripts/manager-shell';</script></body></html>
