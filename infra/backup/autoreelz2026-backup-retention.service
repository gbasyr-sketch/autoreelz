[Unit]
Description=AUTO REELZ encrypted backup to Yandex Disk
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/autoreelz2026-backup/runner/store_backup.py retention
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Moscow
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=100%
MemoryMax=768M
TasksMax=64
TimeoutStartSec=90min
Restart=on-failure
RestartPreventExitStatus=1
RestartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/run/user/1018/docker.sock
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/autoreelz2026-backup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
